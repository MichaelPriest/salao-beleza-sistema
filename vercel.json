{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "api/saas-checkout.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/saas-checkout/?$",
      "dest": "/api/saas-checkout.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "build": {
    "env": {
      "CI": "false"
    }
  }
}
